# Supabase-project (dezelfde als in de web-app)
SUPABASE_URL=https://jouw-project.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Alleen nodig als je Supabase-project nog de oude gedeelde JWT-secret (HS256) gebruikt.
# Met de nieuwe asymmetrische signing keys (standaard) is dit niet nodig.
# SUPABASE_JWT_SECRET=

# 32 willekeurige bytes in base64, voor het versleutelen van de Picnic-sleutel in de database:
#   openssl rand -base64 32
PICNIC_ENCRYPTION_KEY=

# Waar de SQLite-database komt te staan (in Docker: het gemonteerde volume).
DATA_DIR=./data

# Origins van de web-app die deze server mogen aanroepen, komma-gescheiden.
ALLOWED_ORIGINS=http://localhost:5173,https://jouw-app.vercel.app

PORT=8787
PICNIC_COUNTRY=NL
