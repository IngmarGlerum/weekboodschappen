# Kopieer naar .env.local en vul in. Zonder deze waarden draait de app in
# "lokale modus": geen login, geen synchronisatie, alleen op dit apparaat.

# Supabase: Project Settings > API
VITE_SUPABASE_URL=https://jouw-project.supabase.co
# De publieke sleutel (anon key of publishable key). Nooit de service_role-sleutel hier.
VITE_SUPABASE_ANON_KEY=

# PowerSync: de URL van jouw instance (PowerSync dashboard > Connect)
VITE_POWERSYNC_URL=https://jouw-instance.powersync.journeyapps.com
